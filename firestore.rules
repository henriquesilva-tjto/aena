rules_version = '2';

// AENA - Regras de segurança do Firestore
// Publicar em: Console do Firebase > Firestore Database > Regras (colar e "Publicar").
service cloud.firestore {
  match /databases/{database}/documents {

    function caminhoUsuario() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function logado() { return request.auth != null; }
    function eu() { return get(caminhoUsuario()).data; }
    function ativo() { return logado() && exists(caminhoUsuario()) && eu().ativo == true; }
    function perfil(lista) { return ativo() && eu().papel in lista; }

    // ---------- Usuários ----------
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || perfil(['admin']));
      allow create: if perfil(['admin'])
        // primeiro administrador (página setup.html), uma única vez
        || (logado() && request.auth.uid == uid
            && request.resource.data.papel == 'admin'
            && !exists(/databases/$(database)/documents/config/bootstrap)
            && existsAfter(/databases/$(database)/documents/config/bootstrap));
      allow update: if perfil(['admin'])
        // o próprio usuário só altera estes campos
        || (ativo() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trocarSenha', 'ultimoAcesso', 'alteradoEm']));
      allow delete: if false;
    }

    // ---------- Configuração ----------
    match /config/bootstrap {
      allow read: if true;
      allow create: if logado()
        && !exists(/databases/$(database)/documents/config/bootstrap)
        && getAfter(caminhoUsuario()).data.papel == 'admin';
      allow update, delete: if false;
    }
    match /config/geral {
      allow read: if ativo();
      allow write: if perfil(['admin']);
    }

    // ---------- Cadastros e compras (Diretor) ----------
    match /produtos/{id}     { allow read: if ativo(); allow write: if perfil(['admin', 'diretor']); }
    match /escolas/{id}      { allow read: if ativo(); allow write: if perfil(['admin', 'diretor']); }
    match /fornecedores/{id} { allow read: if ativo(); allow write: if perfil(['admin', 'diretor']); }
    match /entradas/{id}     { allow read: if ativo(); allow write: if perfil(['admin', 'diretor']); }
    match /saidas/{id}       { allow read: if ativo(); allow write: if perfil(['admin', 'diretor']); }
    match /repasses/{id}     { allow read: if ativo(); allow write: if perfil(['admin', 'diretor']); }

    // ---------- Fichas técnicas e cardápios (Nutricionista) ----------
    match /preparacoes/{id} { allow read: if ativo(); allow write: if perfil(['admin', 'nutricionista']); }
    match /cardapios/{id}   { allow read: if ativo(); allow write: if perfil(['admin', 'nutricionista']); }

    // ---------- Registro diário (Merendeira) ----------
    match /refeicoes/{id} {
      allow read: if ativo();
      allow create: if perfil(['admin', 'diretor'])
        || (perfil(['merendeira'])
            && request.resource.data.escolaId == eu().escolaId
            && request.resource.data.criadoPorUid == request.auth.uid);
      allow update: if perfil(['admin', 'diretor']);
      allow delete: if perfil(['admin', 'diretor'])
        || (perfil(['merendeira']) && resource.data.criadoPorUid == request.auth.uid);
    }

    // ---------- Resumo de estoque (atualizado junto com entradas/saídas/refeições) ----------
    match /estoque/{produtoId} {
      allow read: if ativo();
      allow write: if perfil(['admin', 'diretor', 'merendeira']);
    }

    // ---------- Registro de atividades ----------
    match /log/{id} {
      allow read: if perfil(['admin']);
      allow create: if ativo() && request.resource.data.por == eu().login;
      allow update, delete: if false;
    }
  }
}
